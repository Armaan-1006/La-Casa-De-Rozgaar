# Environment Configuration for Module 1 - Intelligence Platform

# Server
NODE_ENV=development
PORT=3001
HOST=0.0.0.0

# Database
DATABASE_URL=postgresql://lacasa:lacasa_dev_password@localhost:5432/lacasa_intelligence
DB_HOST=localhost
DB_PORT=5432
DB_NAME=lacasa_intelligence
DB_USER=lacasa
DB_PASSWORD=lacasa_dev_password
DB_MAX_CONNECTIONS=20
DB_IDLE_TIMEOUT=30000

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# API
API_PREFIX=/api/v1
API_RATE_LIMIT_MAX=100
API_RATE_LIMIT_WINDOW=60000

# Security
API_KEY_INGESTION=your-secure-ingestion-api-key-change-in-production
JWT_SECRET=your-jwt-secret-change-in-production
CORS_ORIGIN=http://localhost:5173

# ML Service
ML_SERVICE_URL=http://localhost:8000
ML_SERVICE_TIMEOUT=30000

# Logging
LOG_LEVEL=info
LOG_PRETTY=true

# Workers
WORKER_CONCURRENCY=5
WORKER_REMOVE_ON_COMPLETE=100
WORKER_REMOVE_ON_FAIL=1000

# Data Quality
DATA_QUALITY_MIN_CONFIDENCE=0.7
DATA_FRESHNESS_WARNING_DAYS=7
DATA_FRESHNESS_ERROR_DAYS=30

# Ingestion
INGESTION_BATCH_SIZE=100
INGESTION_MAX_RETRIES=3

# Forecasting
FORECAST_HORIZON_DAYS=90
FORECAST_MIN_SAMPLE_SIZE=50

# Feature Flags
ENABLE_ML_EXTRACTION=true
ENABLE_FORECASTING=true
ENABLE_TREND_DETECTION=true
