# Module 2 Environment Configuration
# Copy this file to .env and configure

# Server
PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# Database
DATABASE_PATH=./data/module2.db

# JWT
JWT_SECRET=change-this-to-a-secure-random-string-in-production
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# Intelligence Provider: mock | remote
INTELLIGENCE_PROVIDER=mock

# Module 1 API (when INTELLIGENCE_PROVIDER=remote)
MODULE1_API_URL=http://localhost:3000/api/v1
MODULE1_API_KEY=

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info

# CORS
CORS_ORIGIN=http://localhost:5173

# Assessment
ASSESSMENT_MAX_DURATION_MINUTES=120
ASSESSMENT_INTEGRITY_THRESHOLD=3
