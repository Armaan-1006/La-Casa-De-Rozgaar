
{
  "version": 2,
  "builds": [
    {
      "src": "src/server.ts",
      "use": "@vercel/node",
      "config": {
        "maxDuration": 60
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "src/server.ts"
    }
  ],
  "crons": [
    {
      "path": "/api/v1/cron/collect-jobs",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/v1/cron/collect-jobs",
      "schedule": "0 13 * * *"
    }
  ]
}
